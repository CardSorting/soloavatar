# Database Configuration
DATABASE_URL="postgresql://avatar_user:avatar_password@localhost:5432/avatar_drop_system"

# Enhanced Database Settings (optional, sensible defaults provided)
DB_CONNECTION_TIMEOUT="10000"
DB_QUERY_TIMEOUT="30000"
DB_MAX_CONNECTIONS="10"

# AI API Keys
GEMINI_API_KEY="your_gemini_api_key"
REPLICATE_API_TOKEN="your_replicate_api_token"

# Enhanced Local Storage Configuration
STORAGE_TYPE="local"
STORAGE_BASE_URL="http://localhost:3000"
STORAGE_BASE_DIR="data/storage"
STORAGE_MAX_FILE_SIZE_MB="10"
STORAGE_MAX_TOTAL_GB="5"

# Automatic Storage Cleanup (optional)
STORAGE_AUTO_CLEANUP="true"
STORAGE_CLEANUP_DAYS="30"

# Application Configuration
NODE_ENV="development"

# Optional: Logging
LOG_LEVEL="info"

# Development Options
# Uncomment to enable enhanced Prisma query logging
# PRISMA_LOG_QUERIES="true"
